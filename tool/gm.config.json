{
  "_note": "Adapter for the Game Master API. baseUrl and matchId stay null here: the launch prompt's values go in with 'mtm init --base-url <url> --match <id>'. When the organizers' docs arrive, edit endpoints (HTTP path, or an 'exec' command of the Game Player tool), map (where each field lives; an empty string means the whole response) and states.",
  "adapterStatus": "REHEARSAL_ONLY",
  "baseUrl": null,
  "matchId": null,
  "auth": { "header": "Authorization", "scheme": "Bearer", "tokenEnv": "MTM_TOKEN" },
  "headers": {},
  "http": { "timeoutMs": 15000 },
  "endpoints": {
    "match":  { "method": "GET",  "path": "/api/matches/{matchId}" },
    "start":  { "method": "POST", "path": "/api/matches/{matchId}/items/{itemId}/start" },
    "submit": { "method": "POST", "path": "/api/matches/{matchId}/items/{itemId}/submissions" },
    "ready":  { "method": "POST", "path": "/api/matches/{matchId}/ready" }
  },
  "map": {
    "matchStatus": "status",
    "matchId": "id",
    "serverTime": "serverTime",
    "endsAt": "endsAt",
    "totalScore": "score",
    "items": "items",
    "item": {
      "id": "id",
      "type": "type",
      "title": "title",
      "description": "description",
      "state": "state",
      "maxPoints": "maxPoints",
      "revealedAt": "revealedAt",
      "deadlineAt": "deadlineAt",
      "deadlineMinutes": "deadlineMinutes",
      "submissionStatus": "submission.status",
      "result": "submission.result",
      "score": "submission.score",
      "failReason": "submission.detail"
    },
    "startTemplate": "template",
    "startMvs": "mvs",
    "startStatus": "status",
    "submitStatus": "status"
  },
  "states": {
    "finishedStates": ["FINISHED", "ENDED", "COMPLETED", "CLOSED", "OVER"],
    "pausedStates": ["PAUSED"],
    "doneStatuses": ["ACCEPTED", "SUBMITTED", "RECEIVED", "QUEUED", "GRADING", "GRADED", "PASSED", "FAILED"]
  },
  "submit": {
    "revisionField": "gitRevision",
    "itemIdField": null,
    "evidenceRequiredFor": ["CR", "BUG"],
    "gradedBranch": null,
    "remote": "origin",
    "acceptedValues": ["ACCEPTED", "SUBMITTED", "RECEIVED", "QUEUED", "OK", "SUCCESS"],
    "duplicatePattern": "already (been )?submitted|duplicate submission|already has a submission",
    "duplicateValues": ["ALREADY_SUBMITTED", "DUPLICATE"],
    "alreadyStartedPattern": "already (started|working|in progress)"
  },
  "evidence": { "timeoutMinutes": 6 },
  "planner": {
    "urgentMinutes": 12,
    "minFeasibleMinutes": { "PI": 4, "BUG": 5, "CR": 8, "TASK": 4 },
    "estMinutes": { "PI": 8, "BUG": 6, "TASK": 5, "CR": 12 },
    "budgetFactor": 1.5,
    "wrapUpMinutes": 5,
    "actionableStates": ["OPEN", "VISIBLE"],
    "terminalStates": ["CLOSED", "EXPIRED", "CANCELLED", "REMOVED"]
  }
}
