{
  "login": {
    "strategy": "auto",
    "strategies": [
      "nextauth",
      "form",
      "json"
    ],
    "nextAuthBasePath": "/api/auth",
    "nextAuthProviders": [
      "credentials"
    ],
    "loginPaths": [
      "/login",
      "/sign-in",
      "/signin",
      "/auth/login",
      "/"
    ],
    "jsonLoginPaths": [
      "/api/auth/login",
      "/api/login",
      "/api/v1/auth/login"
    ]
  },
  "matchView": {
    "pagePathTemplate": "{matchPageUrl}/{matchId}",
    "extraJsonPaths": [
      "/api/v1/match/{matchId}"
    ],
    "assignmentCheck": "block",
    "repoHostAliases": {},
    "mcpUrl": null
  },
  "polling": {
    "successMs": 5000,
    "errorMs": 10000,
    "backgroundMs": 20000,
    "maxWaitMs": 55000
  },
  "submit": {
    "acceptedStatuses": [
      "ACCEPTED",
      "RECEIVED"
    ],
    "retryBudgetMs": 60000
  },
  "planner": {
    "estMinutes": {
      "PI": 10,
      "BUG": 10,
      "TASK": 8,
      "CR": 14
    },
    "minFeasibleMinutes": {
      "PI": 4,
      "BUG": 5,
      "CR": 7,
      "TASK": 4
    },
    "urgentMinutes": 12,
    "wrapUpMinutes": 5,
    "budgetFactor": 1.5
  },
  "heavyTask": {
    "mode": "last",
    "startAfter": "othersDispatched",
    "minMinutesLeft": 0,
    "maxParallel": 2,
    "minPoints": 200,
    "minDescriptionChars": 6000,
    "minCriteria": 12
  },
  "parallel": {
    "maxCodeWorkers": 6,
    "maxAnswerWorkers": 6,
    "maxWorkerThreads": 14,
    "maxBuilds": 2,
    "materialConcurrency": 4,
    "portBase": 3100,
    "workerEffort": { "answerOnly": "low", "pi": "medium", "code": "medium", "retry": "high" },
    "workerModels": {
      "pi": ["gpt-6.1-sol"],
      "cr": ["gpt-6.1-sol"],
      "answerOnly": ["gpt-6.1-sol"],
      "answerOnlySource": ["gpt-6.1-sol"],
      "code": ["gpt-6.1-sol"],
      "retry": ["gpt-6.1-sol"]
    }
  }
}
